{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_image = current_variant.featured_image | default: product.featured_image
%}

<div
  class="vto-react-root"
  data-vto-react-root
  data-product-title="{{ product.title | escape }}"
  data-product-handle="{{ product.handle | escape }}"
  data-initial-image="{{ current_image | image_url: width: 1600 }}"
  style="--vto-color: {{ block.settings.button_color }}; --vto-text: {{ block.settings.button_text_color }};"
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-vto-config>
    { "variants": {
      {% for variant in product.variants %}
        "{{ variant.id }}": "{{ variant.featured_image | default: product.featured_image | image_url: width: 1600 }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
      },
      "buttonLabel": {{ block.settings.button_label | json }},
      "modalTitle": {{ block.settings.modal_title | json }},
      "instructions": {{ block.settings.instructions | json }},
      "consentText": {{ block.settings.consent_text | json }},
      "generateLabel": {{ block.settings.generate_label | json }}
    }
  </script>
</div>

{% schema %}
{
  "name": "AI Virtual Try-On",
  "target": "section",
  "stylesheet": "virtual-try-on.css",
  "javascript": "virtual-try-on.js",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try it on with AI" },
    { "type": "text", "id": "modal_title", "label": "Modal title", "default": "Virtual Try-On" },
    { "type": "textarea", "id": "instructions", "label": "Instructions", "default": "Upload a clear, front-facing full-body photo with good lighting." },
    { "type": "textarea", "id": "consent_text", "label": "Consent text", "default": "I consent to my photo being processed to create this try-on. The store does not retain the upload." },
    { "type": "text", "id": "generate_label", "label": "Generate button", "default": "Generate my try-on" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" }
  ]
}
{% endschema %}
