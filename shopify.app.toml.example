# Rename to shopify.app.toml and replace the values after creating the app.
client_id = "YOUR_SHOPIFY_CLIENT_ID"
name = "AI Virtual Try-On"
application_url = "https://YOUR-BACKEND-DOMAIN.example"
embedded = true

[build]
automatically_update_urls_on_dev = true

[access_scopes]
scopes = ""

[app_proxy]
url = "https://YOUR-VERCEL-DOMAIN.vercel.app/api/proxy"
prefix = "apps"
subpath = "virtual-try-on"

[auth]
redirect_urls = [ "https://YOUR-BACKEND-DOMAIN.example/auth/callback" ]
