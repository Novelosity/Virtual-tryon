# Set these in Vercel: Project Settings -> Environment Variables
# (Production, Preview, Development). Only api/proxy.js reads them; nothing in
# this repo loads a local .env file, and none of them reach the browser.

# OpenRouter API key (sk-or-v1-...) on an account with credits loaded.
OPENROUTER_API_KEY=sk-or-v1-your-key

# Model slug for POST https://openrouter.ai/api/v1/images. Default when unset:
# openai/gpt-image-2 — the model this app's prompt was written for and the
# strongest at preserving a person's identity through an edit. Any slug from
# GET /api/v1/images/models that accepts input_references also works, for example
# google/gemini-3.1-flash-image or bytedance-seed/seedream-4.5. The proxy sends
# quality and output_compression only to the openai/* models, the only ones whose
# endpoints accept them.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# Client secret of the Shopify app whose client_id is in shopify.app.toml.
# The proxy verifies Shopify's App Proxy `signature` HMAC with this value, so a
# secret from a different app — or a stale one after a rotation — makes every
# request fail signature verification with 401 "Invalid Shopify request."
SHOPIFY_API_SECRET=your-shopify-app-client-secret

# Maximum shopper upload size in MB. Default when unset: 4
# Keep at 4 or below: Vercel caps a function request/response body at 4.5 MB.
MAX_UPLOAD_MB=4
